# Maintainer: Sanjivns
#
# NuvioDev - personal, unofficial fork of Nuvio Desktop.
# The AppImage is produced by the "Release NuvioDev" GitHub Actions workflow.
#
# To bump: set _realver to a release tag that ships the Linux AppImage
# (e.g. "0.3-alpha.21"), set pkgver to the same version without hyphens
# (pacman forbids "-" in pkgver), then replace the sha256sums entry with the
# release asset digest:
#   gh release view <tag> --repo somerandProject/NuvioDesktop \
#     --json assets --jq '.assets[] | select(.name | test("AppImage")) | .digest'
# (the digest is prefixed with "sha256:").

_realver=0.3-alpha.21
pkgname=nuvio-dev
pkgver=0.3alpha21
pkgrel=1
pkgdesc="NuvioDev - personal fork of Nuvio Desktop (portable AppImage)"
arch=('x86_64')
url="https://github.com/somerandProject/NuvioDesktop"
license=('GPL3')
depends=(
  'mpv'
  'webkit2gtk-4.1'
  'gst-plugins-good'
  'gst-libav'
  'libxcomposite'
  'glib-networking'
  'fuse2'
)
optdepends=(
  'xdg-utils: open external links in the browser'
)
source=(
  "NuvioDev-Linux-x86_64-${_realver}.AppImage::https://github.com/somerandProject/NuvioDesktop/releases/download/${_realver}/NuvioDev-Linux-x86_64-${_realver}.AppImage"
)
sha256sums=('SKIP')

build() {
  cd "$srcdir"
  chmod +x "NuvioDev-Linux-x86_64-${_realver}.AppImage"
  # --appimage-extract works without FUSE, so this runs on minimal setups.
  "./NuvioDev-Linux-x86_64-${_realver}.AppImage" --appimage-extract > /dev/null
  [[ -x squashfs-root/AppRun ]] || {
    echo "AppImage extraction failed (no squashfs-root/AppRun)." >&2
    return 1
  }
}

package() {
  # The AppImage mounts itself at runtime; only the image + launcher are
  # installed here.
  install -Dm755 "NuvioDev-Linux-x86_64-${_realver}.AppImage" \
    "$pkgdir/opt/nuvio-dev/NuvioDev.AppImage"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/nuvio-dev" << 'EOF'
#!/bin/sh
exec /opt/nuvio-dev/NuvioDev.AppImage "$@"
EOF

  local icon_source="$srcdir/squashfs-root/.DirIcon"
  if [[ -e "$icon_source" ]]; then
    install -Dm644 "$(readlink -f "$icon_source")" "$pkgdir/usr/share/icons/hicolor/256x256/apps/nuvio-dev.png"
  fi

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/nuvio-dev.desktop" << 'EOF'
[Desktop Entry]
Type=Application
Name=NuvioDev
GenericName=Media Player
Comment=Nuvio Media Player (personal fork)
Exec=/opt/nuvio-dev/NuvioDev.AppImage %u
Icon=nuvio-dev
Terminal=false
Categories=AudioVideo;
StartupNotify=true
StartupWMClass=com-nuvio-app-MainKt
MimeType=x-scheme-handler/nuvio;x-scheme-handler/stremio;
EOF
}
